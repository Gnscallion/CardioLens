# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------- 运行时数据
# store/ 存放 SQLite 数据库与运行日志，含真实用户数据，不纳入版本控制。
# （Web 版默认写在项目根的 store/；生产部署可用 CARDIOLENS_STORE 指到别处。）
store/

# ---------------------------------------------------------------- 打包产物
# 桌面版 EXE 的构建产物。CardioLens.exe 已单独备份到项目外的
# ..\CardioLens_pre_web_backup\，未进 git（避免仓库永久膨胀约 309 MB）。
dist/
dist_selftest/
build/
build_selftest/

# ---------------------------------------------------------------- 数据
# 原始 parquet（约 83 MB）可由 python -m src.prepare_data 重新下载。
data/raw/
# 训练样本集（约 91 MB）。推理链路不需要它，只有重新训练时才需要，
# 因此不随仓库分发（桌面版打包时同样排除）。
data/processed/beats.npz

# ---------------------------------------------------------------- 杂项
.DS_Store
Thumbs.db

# 注意：models/*.log（train_run2/3/4.log、_train.log）是报告引用的训练证据，
# 刻意不使用全局的 *.log 规则忽略，保持纳入版本控制。
